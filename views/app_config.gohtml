{{define "content"}}
    <h2>应用配置详情</h2>
      <!-- 配置文件路径显示 -->
    <div class="card mb-3">
        <div class="card-header">
            <h6 class="mb-0"><i class="bi bi-file-text"></i> 配置文件路径</h6>
        </div>
        <div class="card-body py-2">
            <div class="input-group">
                <input type="text" class="form-control" value="{{.ConfigFilePath}}" readonly>
                <button class="btn btn-outline-secondary" type="button" id="copyPathBtn" title="复制路径">
                    <i class="bi bi-clipboard"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- 进程信息显示 -->
    <div class="card mb-3">
        <div class="card-header">
            <h6 class="mb-0"><i class="bi bi-cpu"></i> 进程信息</h6>
        </div>
        <div class="card-body py-2">
            <div class="row">
                <div class="col-md-6 mb-2">
                    <label class="form-label text-muted small">程序执行路径</label>
                    <div class="input-group">
                        <input type="text" class="form-control" value="{{.ExecutablePath}}" readonly>
                        <button class="btn btn-outline-secondary" type="button" id="copyExecPathBtn" title="复制程序路径">
                            <i class="bi bi-clipboard"></i>
                        </button>
                    </div>
                </div>
                <div class="col-md-6 mb-2">
                    <label class="form-label text-muted small">工作目录</label>
                    <div class="input-group">
                        <input type="text" class="form-control" value="{{.WorkingDirectory}}" readonly>
                        <button class="btn btn-outline-secondary" type="button" id="copyWorkDirBtn" title="复制工作目录">
                            <i class="bi bi-clipboard"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Profile 管理 -->
    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div>
                <h6 class="mb-0"><i class="bi bi-diagram-3"></i> SSH Profile 管理</h6>
                <small class="text-muted" id="profileSwitchStatusText">切换状态：未执行</small>
            </div>
            <div class="btn-group" role="group">
                <button class="btn btn-sm btn-outline-success" type="button" id="testAllProfilesBtn">
                    <i class="bi bi-activity"></i> 测试全部
                </button>
                <button class="btn btn-sm btn-primary" type="button" id="openCreateProfileBtn">
                    <i class="bi bi-plus-circle"></i> 新增 Profile
                </button>
                <button class="btn btn-sm btn-outline-secondary" type="button" id="reloadProfilesBtn">
                    <i class="bi bi-arrow-clockwise"></i> 刷新列表
                </button>
            </div>
        </div>
        <div class="card-body">
            <div class="profile-list-toolbar mb-3" aria-label="Profile 列表排序与筛选">
                <div class="profile-list-toolbar-grid">
                    <div class="profile-list-search">
                        <label class="form-label small text-muted" for="profileListSearch">搜索</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text"><i class="bi bi-search"></i></span>
                            <input class="form-control" id="profileListSearch" type="search"
                                   placeholder="Profile ID、SSH 用户或目标地址" autocomplete="off">
                        </div>
                    </div>
                    <div>
                        <label class="form-label small text-muted" for="profileStatusFilterBtn">状态</label>
                        <div class="dropdown">
                            <button class="btn btn-sm btn-outline-secondary dropdown-toggle w-100 text-start"
                                    id="profileStatusFilterBtn" type="button" data-bs-toggle="dropdown"
                                    data-bs-auto-close="outside" aria-expanded="false">
                                全部状态
                            </button>
                            <div class="dropdown-menu p-2 profile-status-filter-menu" aria-labelledby="profileStatusFilterBtn">
                                <div class="form-check">
                                    <input class="form-check-input profile-status-filter" type="checkbox" value="testing" id="profileStatusTesting">
                                    <label class="form-check-label" for="profileStatusTesting">测试中</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input profile-status-filter" type="checkbox" value="reachable" id="profileStatusReachable">
                                    <label class="form-check-label" for="profileStatusReachable">可用</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input profile-status-filter" type="checkbox" value="degraded" id="profileStatusDegraded">
                                    <label class="form-check-label" for="profileStatusDegraded">异常</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input profile-status-filter" type="checkbox" value="unreachable" id="profileStatusUnreachable">
                                    <label class="form-check-label" for="profileStatusUnreachable">不通</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input profile-status-filter" type="checkbox" value="unknown" id="profileStatusUnknown">
                                    <label class="form-check-label" for="profileStatusUnknown">未知</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div>
                        <label class="form-label small text-muted" for="profileAccessDataFilter">访问数据</label>
                        <select class="form-select form-select-sm" id="profileAccessDataFilter">
                            <option value="all">全部</option>
                            <option value="present">有访问样本</option>
                            <option value="missing">无访问样本</option>
                        </select>
                    </div>
                    <div>
                        <label class="form-label small text-muted" for="profileManualDataFilter">手测数据</label>
                        <select class="form-select form-select-sm" id="profileManualDataFilter">
                            <option value="all">全部</option>
                            <option value="present">已手测</option>
                            <option value="missing">未手测</option>
                        </select>
                    </div>
                    <div>
                        <label class="form-label small text-muted" for="profileSortKey">排序</label>
                        <select class="form-select form-select-sm" id="profileSortKey">
                            <option value="quality">综合质量</option>
                            <option value="status">状态</option>
                            <option value="successRate">成功率</option>
                            <option value="avgLatency">访问平均延迟</option>
                            <option value="p95Latency">访问 P95</option>
                            <option value="sshLatency">SSH 握手延迟</option>
                            <option value="egressLatency">出口探测延迟</option>
                            <option value="recent">最近活动</option>
                            <option value="profileId">Profile ID</option>
                        </select>
                    </div>
                    <div class="profile-list-direction">
                        <label class="form-label small text-muted" for="profileSortDirection">方向</label>
                        <button class="btn btn-sm btn-outline-primary w-100" id="profileSortDirection" type="button">
                            <i class="bi bi-sort-down me-1"></i><span>好 → 差</span>
                        </button>
                    </div>
                </div>
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-2">
                    <small class="text-muted" id="profileListResultCount" aria-live="polite">显示 0 / 共 0 个 Profile</small>
                    <button class="btn btn-sm btn-link text-decoration-none" id="resetProfileListViewBtn" type="button">
                        <i class="bi bi-arrow-counterclockwise me-1"></i>重置排序与筛选
                    </button>
                </div>
            </div>
            <div class="row">
                <div class="col-12">
                    <div class="table-responsive" id="profilesTableContainer">
                        <table class="table table-sm table-hover mb-0 align-middle" style="min-width: 1180px;">
                            <thead>
                            <tr>
                                <th style="width: 14%">Profile ID</th>
                                <th style="width: 10%">SSH用户</th>
                                <th style="width: 15%">目标地址</th>
                                <th style="width: 12%">状态</th>
                                <th style="width: 27%">近 24 小时访问质量</th>
                                <th style="width: 22%">操作</th>
                            </tr>
                            </thead>
                            <tbody id="profilesTableBody">
                            <tr>
                                <td colspan="6" class="text-muted">正在加载...</td>
                            </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Profile 编辑弹窗 -->
    <div class="modal fade" id="profileModal" tabindex="-1" aria-labelledby="profileModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="profileModalLabel">
                        <i class="bi bi-diagram-3"></i> 新增/更新 Profile
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="profileForm">
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-md-6 mb-2">
                                <label for="profileId" class="form-label mb-1">Profile ID（必填）</label>
                                <input type="text" class="form-control" id="profileId" placeholder="例如：default" required>
                            </div>
                            <div class="col-md-6 mb-2">
                                <label for="profileServerIp" class="form-label mb-1">Server IP</label>
                                <input type="text" class="form-control" id="profileServerIp" placeholder="例如：47.56.255.129" required>
                            </div>
                            <div class="col-md-6 mb-2">
                                <label for="profileServerSshPort" class="form-label mb-1">SSH Port</label>
                                <input type="number" class="form-control" id="profileServerSshPort" placeholder="例如：22" value="22" min="1" max="65535" required>
                            </div>
                            <div class="col-md-6 mb-2">
                                <label for="profileLoginUser" class="form-label mb-1">Login User</label>
                                <input type="text" class="form-control" id="profileLoginUser" placeholder="例如：root" required>
                            </div>
                            <div class="col-md-6 mb-2">
                                <label for="profilePrivateKeyPath" class="form-label mb-1">Private Key Path</label>
                                <input type="text" class="form-control" id="profilePrivateKeyPath" placeholder="例如：C:/Users/xx/.ssh/id_rsa" required>
                            </div>
                            <div class="col-md-6 mb-2">
                                <label for="profileLocalAddress" class="form-label mb-1">SOCKS5 Local Address</label>
                                <input type="text" class="form-control" id="profileLocalAddress" placeholder="例如：0.0.0.0:1081" required>
                            </div>
                            <div class="col-md-6 mb-2">
                                <label for="profileHttpLocalAddress" class="form-label mb-1">HTTP Local Address</label>
                                <input type="text" class="form-control" id="profileHttpLocalAddress" placeholder="例如：0.0.0.0:1082">
                            </div>
                            <div class="col-md-6 mb-2">
                                <label for="profileRetryIntervalSec" class="form-label mb-1">Retry Interval Sec</label>
                                <input type="number" class="form-control" id="profileRetryIntervalSec" placeholder="例如：5" value="5" min="1">
                            </div>
                            <div class="col-md-6 mb-2">
                                <label for="profileHttpBasicUserName" class="form-label mb-1">HTTP Basic User</label>
                                <input type="text" class="form-control" id="profileHttpBasicUserName" placeholder="例如：admin">
                            </div>
                            <div class="col-md-6 mb-2">
                                <label for="profileHttpBasicPassword" class="form-label mb-1">HTTP Basic Password</label>
                                <input type="text" class="form-control" id="profileHttpBasicPassword" placeholder="例如：password">
                            </div>
                            <div class="col-12 mb-2">
                                <label for="profileHttpDomainFilterFilePath" class="form-label mb-1">Domain Filter File Path</label>
                                <input type="text" class="form-control" id="profileHttpDomainFilterFilePath" placeholder="例如：C:/ssh-tunnel/.ssh-tunnel/domain.txt">
                            </div>
                        </div>
                        <div class="row mt-2 mb-0">
                            <div class="col-md-6">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="profileEnableSocks5" checked>
                                    <label class="form-check-label" for="profileEnableSocks5">启用 SOCKS5</label>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="profileEnableHttp">
                                    <label class="form-check-label" for="profileEnableHttp">启用 HTTP</label>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="profileEnableHttpOverSSH">
                                    <label class="form-check-label" for="profileEnableHttpOverSSH">启用 HTTP Over SSH</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="profileHttpBasicAuthEnable">
                                    <label class="form-check-label" for="profileHttpBasicAuthEnable">启用 HTTP Basic</label>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="profileEnableHttpDomainFilter">
                                    <label class="form-check-label" for="profileEnableHttpDomainFilter">启用域名过滤</label>
                                </div>
                            </div>
                        </div>

                        <!-- SSH Pool Size -->
                        <div class="row mt-3">
                            <div class="col-md-6 mb-2">
                                <label for="profileSSHPoolSize" class="form-label mb-1">SSH 连接池大小（路由Profile）</label>
                                <input type="number" class="form-control" id="profileSSHPoolSize" placeholder="默认: 2" value="2" min="1" max="20">
                                <small class="form-text text-muted">作为路由Profile时使用的SSH连接池大小</small>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" id="clearProfileFormBtn">
                            <i class="bi bi-eraser"></i> 清空
                        </button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                        <button type="submit" class="btn btn-primary" id="saveProfileBtn">
                            <i class="bi bi-save"></i> 保存 Profile
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- 搜索和操作区域 -->
    <div class="card mb-3">
        <div class="card-body py-2">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control" id="configSearch" 
                               placeholder="搜索配置项或描述...">
                    </div>
                </div>
                <div class="col-md-3">
                    <select class="form-select" id="categoryFilter">
                        <option value="">所有分类</option>
                        <option value="服务器配置">服务器配置</option>
                        <option value="SSH配置">SSH配置</option>
                        <option value="代理配置">代理配置</option>
                        <option value="认证配置">认证配置</option>
                        <option value="过滤配置">过滤配置</option>
                        <option value="管理配置">管理配置</option>
                        <option value="高级配置">高级配置</option>
                    </select>
                </div>                <div class="col-md-3 text-end">
                    <div class="btn-group" role="group">
                        <button class="btn btn-outline-success" onclick="location.reload()" title="刷新配置">
                            <i class="bi bi-arrow-clockwise"></i> 刷新
                        </button>
                        <button class="btn btn-outline-warning" id="cleanupBtn" title="清理重复配置">
                            <i class="bi bi-trash3"></i> 清理
                        </button>
                        <button class="btn btn-outline-primary" id="copyAllBtn" title="复制所有配置">
                            <i class="bi bi-clipboard"></i> 复制
                        </button>
                        <button class="btn btn-outline-danger" id="restartServiceBtn" title="重启服务" style="display: none;">
                            <i class="bi bi-arrow-repeat"></i> 重启服务
                        </button>
                    </div>
                    <div id="runningModeInfo" class="mt-2" style="display: none;">
                        <small class="text-muted" id="runningModeText"></small>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">配置信息</h5>
        </div>
        <div class="card-body">
            <div id="config-container">
                {{if eq (printf "%T" .Config) "map[string]interface {}"}}
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">                            <thead>
                            <tr>
                                <th style="width: 20%">配置项</th>
                                <th style="width: 30%">值</th>
                                <th style="width: 15%">实际配置键</th>
                                <th style="width: 12%">分类</th>
                                <th style="width: 13%">类型</th>
                                <th style="width: 10%">操作</th>
                            </tr>
                            </thead>
                            <tbody>
                            {{range $key, $value := .Config}}
                                {{$meta := index $.ConfigMeta $key}}
                                <tr class="config-item" data-category="{{if $meta}}{{$meta.Category}}{{else}}未分类{{end}}">
                                    <td class="font-weight-bold">
                                        <div>{{$key}}</div>
                                        {{if $meta}}
                                            <small class="text-muted">{{$meta.Description}}</small>
                                            {{if $meta.Required}}
                                                <span class="badge bg-danger ms-1">必需</span>
                                            {{end}}
                                        {{end}}
                                    </td>
                                    <td>
                                        <div class="config-value-display">
                                            {{if eq (printf "%T" $value) "bool"}}
                                                {{if $value}}
                                                    <span class="badge bg-success"><i class="bi bi-check-circle"></i> 启用</span>
                                                {{else}}
                                                    <span class="badge bg-secondary"><i class="bi bi-x-circle"></i> 禁用</span>
                                                {{end}}
                                            {{else if or (eq (printf "%T" $value) "string") (eq (printf "%T" $value) "int") (eq (printf "%T" $value) "float64")}}
                                                <code class="bg-light p-1 rounded">{{printf "%v" $value}}</code>
                                            {{else}}
                                                <pre class="mb-0">{{printf "%v" $value}}</pre>
                                            {{end}}                                        </div>
                                    </td>
                                    <td>
                                        {{if $meta}}
                                            <code class="bg-light p-1 rounded small">{{$meta.ActualKey}}</code>
                                        {{else}}
                                            <span class="text-muted">-</span>
                                        {{end}}
                                    </td>
                                    <td>
                                        {{if $meta}}
                                            <span class="badge bg-info">{{$meta.Category}}</span>
                                        {{else}}
                                            <span class="badge bg-secondary">未分类</span>
                                        {{end}}
                                    </td>
                                    <td>
                                        {{if $meta}}
                                            <span class="badge bg-light text-dark">{{$meta.Type}}</span>
                                        {{else}}
                                            <span class="badge bg-light text-dark">{{printf "%T" $value}}</span>
                                        {{end}}
                                    </td>
                                    <td>                                        <button class="btn btn-sm btn-outline-primary edit-config-btn" 
                                                data-key="{{$key}}" 
                                                data-value="{{printf "%v" $value}}"
                                                data-type="{{if $meta}}{{$meta.Type}}{{else}}string{{end}}"
                                                data-description="{{if $meta}}{{$meta.Description}}{{else}}{{$key}}{{end}}"
                                                data-actual-key="{{if $meta}}{{$meta.ActualKey}}{{else}}{{$key}}{{end}}"
                                                onclick="openEditModal('{{$key}}', '{{printf "%v" $value}}', '{{if $meta}}{{$meta.Type}}{{else}}string{{end}}', '{{if $meta}}{{$meta.Description}}{{else}}{{$key}}{{end}}', '{{if $meta}}{{$meta.ActualKey}}{{else}}{{$key}}{{end}}')">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                    </td>
                                </tr>
                            {{end}}
                            </tbody>
                        </table>
                    </div>                {{else}}
                    <pre id="config-content" class="p-3 bg-light rounded">{{.Config}}</pre>
                {{end}}
            </div>
        </div>
    </div>

    <!-- 配置编辑弹窗 -->
    <div class="modal fade" id="editConfigModal" tabindex="-1" aria-labelledby="editConfigModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="editConfigModalLabel">
                        <i class="bi bi-gear"></i> 编辑配置项
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="editConfigForm">
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="modalConfigKey" class="form-label">配置项名称</label>
                                    <input type="text" class="form-control" id="modalConfigKey" name="key" readonly>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="modalConfigType" class="form-label">数据类型</label>
                                    <select class="form-control" id="modalConfigType" name="type">
                                        <option value="string">字符串 (string)</option>
                                        <option value="int">整数 (int)</option>
                                        <option value="bool">布尔值 (bool)</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                          <div class="mb-3">
                            <label for="modalConfigDescription" class="form-label">配置描述</label>
                            <input type="text" class="form-control" id="modalConfigDescription" readonly>
                        </div>
                        
                        <div class="mb-3">
                            <label for="modalActualKey" class="form-label">实际配置键</label>
                            <input type="text" class="form-control" id="modalActualKey" readonly>
                            <div class="form-text">
                                <small class="text-muted">这是保存到配置文件中的实际键名</small>
                            </div>
                        </div>
                        
                        <div class="mb-3" id="stringValueGroup">
                            <label for="modalConfigValue" class="form-label">配置值</label>
                            <input type="text" class="form-control" id="modalConfigValue" name="value" 
                                   placeholder="输入新的配置值">
                        </div>
                        
                        <div class="mb-3" id="boolValueGroup" style="display: none;">
                            <label class="form-label">配置值</label>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="boolValue" id="boolTrue" value="true">
                                <label class="form-check-label" for="boolTrue">
                                    <i class="bi bi-check-circle text-success"></i> 启用 (true)
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="boolValue" id="boolFalse" value="false">
                                <label class="form-check-label" for="boolFalse">
                                    <i class="bi bi-x-circle text-secondary"></i> 禁用 (false)
                                </label>
                            </div>
                        </div>
                        
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle"></i>
                            <strong>注意：</strong>配置修改后将立即保存到配置文件，部分配置可能需要重启应用才能生效。
                        </div>
                        
                        <div class="alert alert-warning" id="typeHintAlert">
                            <i class="bi bi-exclamation-triangle"></i>
                            <strong>类型提示：</strong>
                            <div id="typeHintContent">
                                <!-- 动态内容 -->
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                        <button type="submit" class="btn btn-primary" id="saveConfigBtn">
                            <i class="bi bi-save"></i> 保存配置
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- 操作结果提示 -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3">
        <div id="resultToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="toast-header">
                <strong class="me-auto">操作结果</strong>
                <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
            <div class="toast-body" id="toastMessage">
                <!-- 消息内容 -->
            </div>
        </div>    </div>    <script>
        // 页面加载时检查运行模式
        let profilesStore = { activeProfileId: '', profiles: {} };
        let profileHealthStore = {};
        let profileTestProgress = {};
        let currentProfileTestId = '';
        let profileHealthTimer = null;
        let currentSwitchId = '';
        let profileModalMode = 'create';
        let profileModalOriginalId = '';
        let profileTablePointerInside = false;
        let pendingProfileTableRender = false;
        const profileTableRows = new Map();
        let profileTestSortSnapshot = {};
        const profileListStorageKey = 'sshTunnel.profileListView.v1';
        const profileListStatuses = ['testing', 'reachable', 'degraded', 'unreachable', 'unknown'];
        const profileListSortKeys = ['quality', 'status', 'successRate', 'avgLatency', 'p95Latency', 'sshLatency', 'egressLatency', 'recent', 'profileId'];
        const profileListDataFilters = ['all', 'present', 'missing'];
        const profileStatusLabels = {
            testing: '测试中',
            reachable: '可用',
            degraded: '异常',
            unreachable: '不通',
            unknown: '未知'
        };
        const defaultProfileListView = () => ({
            query: '',
            statuses: [...profileListStatuses],
            accessData: 'all',
            manualData: 'all',
            sortKey: 'quality',
            sortDirection: 'default'
        });
        let profileListView = loadProfileListView();
        const currentConfigProfileDefaults = {
            serverIp: {{index .Config "ServerIp"}},
            serverSshPort: {{index .Config "ServerSshPort"}},
            loginUser: {{index .Config "LoginUser"}},
            sshPrivateKeyPath: {{index .Config "SshPrivateKeyPath"}},
            localAddress: {{index .Config "LocalAddress"}},
            httpLocalAddress: {{index .Config "HttpLocalAddress"}},
            retryIntervalSec: {{index .Config "RetryIntervalSec"}},
            httpBasicUserName: {{index .Config "HttpBasicUserName"}},
            httpBasicPassword: {{index .Config "HttpBasicPassword"}},
            httpDomainFilterFilePath: {{index .Config "HttpDomainFilterFilePath"}},
            enableSocks5: {{if index .Config "EnableSocks5"}}true{{else}}false{{end}},
            enableHttp: {{if index .Config "EnableHttp"}}true{{else}}false{{end}},
            enableHttpOverSSH: {{if index .Config "EnableHttpOverSSH"}}true{{else}}false{{end}},
            httpBasicAuthEnable: {{if index .Config "HttpBasicAuthEnable"}}true{{else}}false{{end}},
            enableHttpDomainFilter: {{if index .Config "EnableHttpDomainFilter"}}true{{else}}false{{end}}
        };

        document.addEventListener('DOMContentLoaded', function() {
            initializeProfileListControls();
            initializeProfileTableInteractionGuard();
            checkRunningMode();
            loadProfiles();
            loadSwitchStatus();
            startProfileHealthRefresh();
        });

        // 检查运行模式
        function checkRunningMode() {
            fetch('/admin/service/mode', {
                method: 'GET',
                headers: {
                    'Content-Type': 'application/json'
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    const restartBtn = document.getElementById('restartServiceBtn');
                    const modeInfo = document.getElementById('runningModeInfo');
                    const modeText = document.getElementById('runningModeText');
                    
                    if (data.canRestart) {
                        // 服务模式：显示重启按钮
                        restartBtn.style.display = 'inline-block';
                    } else {
                        // 直接运行模式：隐藏重启按钮，显示提示信息
                        restartBtn.style.display = 'none';
                        modeInfo.style.display = 'block';
                        modeText.textContent = data.message;
                    }
                }
            })
            .catch(error => {
                console.error('检查运行模式失败:', error);
                // 出错时隐藏重启按钮以确保安全
                document.getElementById('restartServiceBtn').style.display = 'none';
            });
        }

        async function loadProfiles() {
            try {
                const response = await fetch('/admin/profiles', {
                    method: 'GET',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                });
                const result = await response.json();
                if (!result.success) {
                    showToast('error', result.message || '加载 profiles 失败');
                    return;
                }
                profilesStore = result.data || { activeProfileId: '', profiles: {} };
                await loadProfileHealth(false);
                renderProfilesTable();
            } catch (error) {
                console.error('加载profiles失败:', error);
                showToast('error', '加载 profiles 失败：' + error.message);
            }
        }

        async function loadProfileHealth(render = true) {
            try {
                const response = await fetch('/admin/profiles/health', { method: 'GET' });
                const result = await response.json();
                if (!response.ok || !result.success) {
                    return;
                }
                profileHealthStore = (result.data && result.data.profiles) || {};
                if (render) renderProfilesTable();
            } catch (error) {
                console.error('加载Profile健康统计失败:', error);
            }
        }

        function startProfileHealthRefresh() {
            if (profileHealthTimer) clearInterval(profileHealthTimer);
            profileHealthTimer = setInterval(() => {
                if (!document.hidden) loadProfileHealth();
            }, 5000);
        }

        function renderSwitchStatus(statusData) {
            const textEl = document.getElementById('profileSwitchStatusText');
            if (!textEl) return;

            if (!statusData || !statusData.status) {
                textEl.textContent = '切换状态：未执行';
                return;
            }

            const parts = [];
            parts.push(`切换状态：${statusData.status}`);
            if (statusData.fromProfileId || statusData.toProfileId) {
                parts.push(`(${statusData.fromProfileId || '-'} -> ${statusData.toProfileId || '-'})`);
            }
            if (statusData.message) {
                parts.push(`- ${statusData.message}`);
            }
            textEl.textContent = parts.join(' ');
        }

        async function loadSwitchStatus(switchId = '') {
            try {
                const url = switchId
                    ? `/admin/profiles/switch/status?switchId=${encodeURIComponent(switchId)}`
                    : '/admin/profiles/switch/status';
                const response = await fetch(url, {
                    method: 'GET',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                });
                const result = await response.json();
                if (!result.success) {
                    return null;
                }
                const statusData = result.data || {};
                renderSwitchStatus(statusData);
                return statusData;
            } catch (error) {
                console.error('加载切换状态失败:', error);
                return null;
            }
        }

        async function pollSwitchStatus(switchId) {
            if (!switchId) return;
            currentSwitchId = switchId;
            let tries = 0;
            const maxTries = 35;

            while (tries < maxTries && currentSwitchId === switchId) {
                const statusData = await loadSwitchStatus(switchId);
                if (!statusData) {
                    await new Promise(resolve => setTimeout(resolve, 1000));
                    tries++;
                    continue;
                }

                if (statusData.status === 'COMPLETED') {
                    showToast('success', statusData.message || 'Profile 切换完成');
                    await loadProfiles();
                    setTimeout(() => location.reload(), 1000);
                    return;
                }

                if (statusData.status === 'FAILED') {
                    showToast('error', statusData.message || 'Profile 切换失败');
                    await loadProfiles();
                    return;
                }

                await new Promise(resolve => setTimeout(resolve, 1000));
                tries++;
            }
        }

        function loadProfileListView() {
            const defaults = defaultProfileListView();
            try {
                const parsed = JSON.parse(localStorage.getItem(profileListStorageKey) || '{}');
                const statuses = Array.isArray(parsed.statuses)
                    ? [...new Set(parsed.statuses.filter(status => profileListStatuses.includes(status)))]
                    : defaults.statuses;
                return {
                    query: typeof parsed.query === 'string' ? parsed.query : defaults.query,
                    statuses: statuses.length > 0 ? statuses : defaults.statuses,
                    accessData: profileListDataFilters.includes(parsed.accessData) ? parsed.accessData : defaults.accessData,
                    manualData: profileListDataFilters.includes(parsed.manualData) ? parsed.manualData : defaults.manualData,
                    sortKey: profileListSortKeys.includes(parsed.sortKey) ? parsed.sortKey : defaults.sortKey,
                    sortDirection: parsed.sortDirection === 'reverse' ? 'reverse' : defaults.sortDirection
                };
            } catch (error) {
                console.warn('读取 Profile 列表视图设置失败，已使用默认值:', error);
                return defaults;
            }
        }

        function saveProfileListView() {
            try {
                localStorage.setItem(profileListStorageKey, JSON.stringify(profileListView));
            } catch (error) {
                console.warn('保存 Profile 列表视图设置失败:', error);
            }
        }

        function initializeProfileListControls() {
            syncProfileListControls();
            document.getElementById('profileListSearch').addEventListener('input', function() {
                profileListView.query = this.value;
                applyProfileListViewChange();
            });
            document.querySelectorAll('.profile-status-filter').forEach(input => {
                input.addEventListener('change', function() {
                    let selected = Array.from(document.querySelectorAll('.profile-status-filter:checked')).map(item => item.value);
                    if (selected.length === 0) {
                        selected = [...profileListStatuses];
                        document.querySelectorAll('.profile-status-filter').forEach(item => { item.checked = true; });
                    }
                    profileListView.statuses = selected;
                    applyProfileListViewChange();
                });
            });
            document.getElementById('profileAccessDataFilter').addEventListener('change', function() {
                profileListView.accessData = this.value;
                applyProfileListViewChange();
            });
            document.getElementById('profileManualDataFilter').addEventListener('change', function() {
                profileListView.manualData = this.value;
                applyProfileListViewChange();
            });
            document.getElementById('profileSortKey').addEventListener('change', function() {
                profileListView.sortKey = this.value;
                profileListView.sortDirection = 'default';
                applyProfileListViewChange();
            });
            document.getElementById('profileSortDirection').addEventListener('click', function() {
                profileListView.sortDirection = profileListView.sortDirection === 'default' ? 'reverse' : 'default';
                applyProfileListViewChange();
            });
            document.getElementById('resetProfileListViewBtn').addEventListener('click', resetProfileListView);
        }

        function syncProfileListControls() {
            document.getElementById('profileListSearch').value = profileListView.query;
            document.getElementById('profileAccessDataFilter').value = profileListView.accessData;
            document.getElementById('profileManualDataFilter').value = profileListView.manualData;
            document.getElementById('profileSortKey').value = profileListView.sortKey;
            const selectedStatuses = new Set(profileListView.statuses);
            document.querySelectorAll('.profile-status-filter').forEach(input => {
                input.checked = selectedStatuses.has(input.value);
            });
            updateProfileStatusFilterLabel();
            updateProfileSortDirectionButton();
        }

        function applyProfileListViewChange() {
            saveProfileListView();
            updateProfileStatusFilterLabel();
            updateProfileSortDirectionButton();
            renderProfilesTable({ force: true });
        }

        function resetProfileListView() {
            profileListView = defaultProfileListView();
            syncProfileListControls();
            saveProfileListView();
            renderProfilesTable({ force: true });
        }

        function updateProfileStatusFilterLabel() {
            const button = document.getElementById('profileStatusFilterBtn');
            if (!button) return;
            const statuses = profileListView.statuses;
            if (statuses.length === profileListStatuses.length) {
                button.textContent = '全部状态';
            } else if (statuses.length === 1) {
                button.textContent = profileStatusLabels[statuses[0]] || '状态';
            } else {
                button.textContent = `已选 ${statuses.length} 种状态`;
            }
        }

        function updateProfileSortDirectionButton() {
            const button = document.getElementById('profileSortDirection');
            if (!button) return;
            const labels = {
                quality: ['好 → 差', '差 → 好'],
                status: ['好 → 差', '差 → 好'],
                successRate: ['高 → 低', '低 → 高'],
                avgLatency: ['低 → 高', '高 → 低'],
                p95Latency: ['低 → 高', '高 → 低'],
                sshLatency: ['低 → 高', '高 → 低'],
                egressLatency: ['低 → 高', '高 → 低'],
                recent: ['新 → 旧', '旧 → 新'],
                profileId: ['A → Z', 'Z → A']
            };
            const reverse = profileListView.sortDirection === 'reverse';
            const label = (labels[profileListView.sortKey] || labels.quality)[reverse ? 1 : 0];
            const icon = reverse ? 'bi-sort-up' : 'bi-sort-down';
            button.innerHTML = `<i class="bi ${icon} me-1"></i><span>${label}</span>`;
            button.title = `切换排序方向，当前为 ${label}`;
            button.setAttribute('aria-label', button.title);
        }

        function initializeProfileTableInteractionGuard() {
            const container = document.getElementById('profilesTableContainer');
            if (!container) return;
            container.addEventListener('pointerenter', () => { profileTablePointerInside = true; });
            container.addEventListener('pointerleave', () => {
                profileTablePointerInside = false;
                flushPendingProfileTableRender();
            });
            container.addEventListener('focusout', () => {
                setTimeout(flushPendingProfileTableRender, 0);
            });
        }

        function profileTableInteractionActive() {
            const container = document.getElementById('profilesTableContainer');
            return profileTablePointerInside || (container && container.contains(document.activeElement));
        }

        function flushPendingProfileTableRender() {
            if (!pendingProfileTableRender || profileTableInteractionActive()) return;
            pendingProfileTableRender = false;
            renderProfilesTable({ force: true });
        }

        function numericOrNull(value) {
            const numeric = Number(value);
            return Number.isFinite(numeric) ? numeric : null;
        }

        function timeOrZero(value) {
            if (!value) return 0;
            const timestamp = new Date(value).getTime();
            return Number.isFinite(timestamp) ? timestamp : 0;
        }

        function buildProfileListRow(profileId, profile) {
            const health = profileHealthStore[profileId] || { status: 'unknown', windowHours: 24, pool: {} };
            const progress = profileTestProgress[profileId];
            const progressTesting = progress && (progress.status === 'pending' || progress.status === 'running');
            const effectiveStatus = progressTesting || health.status === 'testing' ? 'testing' : (health.status || 'unknown');
            let sortHealth = profileTestSortSnapshot[profileId] || health;
            if (sortHealth.status === 'testing') sortHealth = { ...sortHealth, status: 'unknown' };
            const sampleCount = Number(sortHealth.sampleCount || 0);
            const successCount = Number(sortHealth.successCount || 0);
            const manual = sortHealth.lastManualTest || {};
            const hasManual = !!manual.completedAt;
            const lastAccessAt = timeOrZero(sortHealth.lastAccess && sortHealth.lastAccess.at);
            const lastManualAt = timeOrZero(manual.completedAt);
            return {
                profileId,
                profile,
                health,
                progress,
                effectiveStatus,
                sortStatus: sortHealth.status || 'unknown',
                isActive: profileId === profilesStore.activeProfileId,
                hasAccessSamples: sampleCount > 0,
                hasSuccessfulAccess: successCount > 0,
                sampleCount,
                successCount,
                successRate: sampleCount > 0 ? numericOrNull(sortHealth.successRate) : null,
                consecutiveFailures: Number(sortHealth.consecutiveFailures || 0),
                avgLatency: successCount > 0 ? numericOrNull(sortHealth.avgDialLatencyMs) : null,
                p95Latency: successCount > 0 ? numericOrNull(sortHealth.p95DialLatencyMs) : null,
                hasManual,
                sshLatency: hasManual && Object.prototype.hasOwnProperty.call(manual, 'sshHandshakeLatencyMs')
                    ? numericOrNull(manual.sshHandshakeLatencyMs) : null,
                egressLatency: hasManual && Object.prototype.hasOwnProperty.call(manual, 'egressProbeLatencyMs')
                    ? numericOrNull(manual.egressProbeLatencyMs) : null,
                manualCompletedAt: lastManualAt,
                lastActivityAt: Math.max(lastAccessAt, lastManualAt)
            };
        }

        function compareNumbers(left, right) {
            if (left === right) return 0;
            return left < right ? -1 : 1;
        }

        function compareOptionalMetric(left, right, ascending, reverse) {
            const leftPresent = left !== null && left !== undefined;
            const rightPresent = right !== null && right !== undefined;
            if (leftPresent !== rightPresent) return leftPresent ? -1 : 1;
            if (!leftPresent) return 0;
            let result = compareNumbers(left, right);
            if (!ascending) result *= -1;
            if (reverse) result *= -1;
            return result;
        }

        function compareQualityCore(left, right) {
            const statusRank = { reachable: 0, degraded: 1, unknown: 2, unreachable: 3 };
            let result = compareNumbers(statusRank[left.sortStatus] ?? 2, statusRank[right.sortStatus] ?? 2);
            if (result !== 0) return result;
            if (left.hasAccessSamples !== right.hasAccessSamples) return left.hasAccessSamples ? -1 : 1;
            if (left.hasAccessSamples) {
                result = compareNumbers(right.successRate ?? 0, left.successRate ?? 0);
                if (result !== 0) return result;
                result = compareNumbers(left.consecutiveFailures, right.consecutiveFailures);
                if (result !== 0) return result;
                result = compareOptionalMetric(left.p95Latency, right.p95Latency, true, false);
                if (result !== 0) return result;
                result = compareOptionalMetric(left.avgLatency, right.avgLatency, true, false);
                if (result !== 0) return result;
                return compareNumbers(right.sampleCount, left.sampleCount);
            }
            if (left.hasManual !== right.hasManual) return left.hasManual ? -1 : 1;
            if (left.hasManual) {
                result = compareOptionalMetric(left.egressLatency, right.egressLatency, true, false);
                if (result !== 0) return result;
                result = compareOptionalMetric(left.sshLatency, right.sshLatency, true, false);
                if (result !== 0) return result;
                return compareNumbers(right.manualCompletedAt, left.manualCompletedAt);
            }
            return 0;
        }

        function compareProfileListRows(left, right) {
            const reverse = profileListView.sortDirection === 'reverse';
            let result = 0;
            switch (profileListView.sortKey) {
                case 'status': {
                    const rank = { testing: 0, reachable: 1, degraded: 2, unknown: 3, unreachable: 4 };
                    result = compareNumbers(rank[left.effectiveStatus] ?? 3, rank[right.effectiveStatus] ?? 3);
                    if (reverse) result *= -1;
                    break;
                }
                case 'successRate':
                    result = compareOptionalMetric(left.hasAccessSamples ? left.successRate : null, right.hasAccessSamples ? right.successRate : null, false, reverse);
                    break;
                case 'avgLatency':
                    result = compareOptionalMetric(left.avgLatency, right.avgLatency, true, reverse);
                    break;
                case 'p95Latency':
                    result = compareOptionalMetric(left.p95Latency, right.p95Latency, true, reverse);
                    break;
                case 'sshLatency':
                    result = compareOptionalMetric(left.sshLatency, right.sshLatency, true, reverse);
                    break;
                case 'egressLatency':
                    result = compareOptionalMetric(left.egressLatency, right.egressLatency, true, reverse);
                    break;
                case 'recent':
                    result = compareOptionalMetric(left.lastActivityAt > 0 ? left.lastActivityAt : null, right.lastActivityAt > 0 ? right.lastActivityAt : null, false, reverse);
                    break;
                case 'profileId':
                    result = left.profileId.localeCompare(right.profileId, 'zh-CN', { numeric: true, sensitivity: 'base' });
                    if (reverse) result *= -1;
                    break;
                case 'quality':
                default:
                    result = compareQualityCore(left, right);
                    if (reverse) result *= -1;
                    break;
            }
            if (result !== 0) return result;
            if (left.isActive !== right.isActive) return left.isActive ? -1 : 1;
            return left.profileId.localeCompare(right.profileId, 'zh-CN', { numeric: true, sensitivity: 'base' });
        }

        function profileRowMatchesFilters(row) {
            if (!profileListView.statuses.includes(row.effectiveStatus)) return false;
            if (profileListView.accessData === 'present' && !row.hasAccessSamples) return false;
            if (profileListView.accessData === 'missing' && row.hasAccessSamples) return false;
            if (profileListView.manualData === 'present' && !row.hasManual) return false;
            if (profileListView.manualData === 'missing' && row.hasManual) return false;
            const query = profileListView.query.trim().toLocaleLowerCase('zh-CN');
            if (!query) return true;
            const profile = row.profile || {};
            const target = `${profile.serverIp || ''}:${profile.serverSshPort || ''}`;
            return [row.profileId, profile.loginUser, profile.serverIp, profile.serverSshPort, target]
                .some(value => String(value || '').toLocaleLowerCase('zh-CN').includes(query));
        }

        function updateProfileTableRow(item, batchRunning) {
            const { profileId, profile, health, progress, effectiveStatus, isActive } = item;
            let row = profileTableRows.get(profileId);
            if (!row) {
                row = document.createElement('tr');
                row.dataset.profileId = profileId;
                row.innerHTML = `
                    <td data-profile-cell="identity"></td>
                    <td data-profile-cell="user"></td>
                    <td data-profile-cell="target"></td>
                    <td data-profile-cell="status"></td>
                    <td data-profile-cell="quality"></td>
                    <td>
                        <div class="d-flex flex-wrap gap-1">
                            <button class="btn btn-sm btn-outline-success" type="button" data-profile-action="test" onclick="testProfile('${escapeAttr(profileId)}')"><i class="bi bi-activity"></i> 测试</button>
                            <button class="btn btn-sm btn-outline-primary" type="button" onclick="fillProfileForm('${escapeAttr(profileId)}')">编辑</button>
                            <button class="btn btn-sm btn-outline-info" type="button" onclick="copyProfile('${escapeAttr(profileId)}')">复制</button>
                            <button class="btn btn-sm" type="button" data-profile-action="switch" onclick="switchProfile('${escapeAttr(profileId)}')">切换</button>
                            <button class="btn btn-sm btn-outline-danger" type="button" data-profile-action="delete" onclick="deleteProfile('${escapeAttr(profileId)}')">删除</button>
                        </div>
                    </td>
                `;
                profileTableRows.set(profileId, row);
            }

            row.querySelector('[data-profile-cell="identity"]').innerHTML = `<code>${escapeHtml(profileId)}</code>${isActive ? '<span class="badge bg-success ms-1">当前</span>' : ''}`;
            row.querySelector('[data-profile-cell="user"]').innerHTML = `<small>${escapeHtml(profile.loginUser || '-')}</small>`;
            row.querySelector('[data-profile-cell="target"]').innerHTML = `<small>${escapeHtml(profile.serverIp || '-')} : ${escapeHtml(profile.serverSshPort || '-')}</small>`;
            row.querySelector('[data-profile-cell="status"]').innerHTML = renderProfileStatus(effectiveStatus, health);
            row.querySelector('[data-profile-cell="quality"]').innerHTML = renderProfileQuality(health, progress);

            const testButton = row.querySelector('[data-profile-action="test"]');
            const switchButton = row.querySelector('[data-profile-action="switch"]');
            const deleteButton = row.querySelector('[data-profile-action="delete"]');
            testButton.disabled = batchRunning;
            switchButton.disabled = isActive;
            switchButton.className = `btn btn-sm ${isActive ? 'btn-secondary' : 'btn-outline-success'}`;
            deleteButton.disabled = isActive;
            return row;
        }

        function updateVisibleProfileRowsInPlace(items, batchRunning) {
            const itemsById = new Map(items.map(item => [item.profileId, item]));
            document.querySelectorAll('#profilesTableBody tr[data-profile-id]').forEach(row => {
                const item = itemsById.get(row.dataset.profileId);
                if (item) updateProfileTableRow(item, batchRunning);
            });
        }

        function renderProfilesTable(options = {}) {
            const tbody = document.getElementById('profilesTableBody');
            const profiles = profilesStore.profiles || {};
            const profileIds = Object.keys(profiles);
			const batchRunning = Object.values(profileTestProgress || {}).some(item => item && (item.status === 'pending' || item.status === 'running'))
				|| Object.values(profileHealthStore || {}).some(item => item && item.status === 'testing');
			const testAllBtn = document.getElementById('testAllProfilesBtn');
			if (testAllBtn) {
				testAllBtn.disabled = batchRunning || profileIds.length === 0;
				testAllBtn.innerHTML = batchRunning
					? '<span class="spinner-border spinner-border-sm me-1"></span>测试中'
					: '<i class="bi bi-activity"></i> 测试全部';
			}

            const allRows = profileIds
                .map(profileId => buildProfileListRow(profileId, profiles[profileId] || {}));
            const rows = allRows
                .filter(profileRowMatchesFilters)
                .sort(compareProfileListRows);

            if (!options.force && profileTableInteractionActive()) {
                updateVisibleProfileRowsInPlace(allRows, batchRunning);
                pendingProfileTableRender = true;
                return;
            }
            pendingProfileTableRender = false;

            const resultCount = document.getElementById('profileListResultCount');
            if (resultCount) resultCount.textContent = `显示 ${rows.length} / 共 ${profileIds.length} 个 Profile`;

            const currentIds = new Set(profileIds);
            profileTableRows.forEach((row, profileId) => {
                if (!currentIds.has(profileId)) profileTableRows.delete(profileId);
            });

            if (profileIds.length === 0) {
				tbody.innerHTML = '<tr data-profile-empty="true"><td colspan="6" class="text-muted text-center py-4">暂无 Profile</td></tr>';
                return;
            }
            if (rows.length === 0) {
                tbody.innerHTML = '<tr data-profile-empty="true"><td colspan="6" class="text-muted text-center py-4">没有符合当前筛选条件的 Profile。<button class="btn btn-sm btn-link" type="button" onclick="resetProfileListView()">重置筛选</button></td></tr>';
                return;
            }

            const visibleIds = new Set(rows.map(item => item.profileId));
            tbody.querySelectorAll('tr').forEach(row => {
                if (row.dataset.profileEmpty || !visibleIds.has(row.dataset.profileId)) row.remove();
            });
            rows.forEach(item => {
                tbody.appendChild(updateProfileTableRow(item, batchRunning));
            });
        }

		function renderProfileStatus(status, health) {
			const definitions = {
				testing: { label: '测试中', className: 'bg-primary', icon: 'bi-arrow-repeat' },
				reachable: { label: '可用', className: 'bg-success', icon: 'bi-check-circle' },
				degraded: { label: '异常', className: 'bg-warning text-dark', icon: 'bi-exclamation-triangle' },
				unreachable: { label: '不通', className: 'bg-danger', icon: 'bi-x-circle' },
				unknown: { label: '未知', className: 'bg-secondary', icon: 'bi-question-circle' }
			};
			const item = definitions[status] || definitions.unknown;
			const pool = health.pool || {};
			const poolIssues = (pool.suspect || 0) + (pool.probing || 0) + (pool.reconnecting || 0);
			const poolText = (pool.healthy || poolIssues || pool.evicted)
				? `SSH池 健康 ${pool.healthy || 0} / 异常 ${poolIssues}${pool.evicted ? ` / 摘除 ${pool.evicted}` : ''}`
				: 'SSH池 未运行';
			return `<span class="badge ${item.className}"><i class="bi ${item.icon} me-1"></i>${item.label}</span><div class="small text-muted mt-1">${poolText}</div>`;
		}

		function formatHealthLatency(value) {
			const numeric = Number(value);
			if (!Number.isFinite(numeric) || numeric < 0) return '--';
			return `${numeric < 10 ? numeric.toFixed(1) : Math.round(numeric)} ms`;
		}

		function formatHealthTime(value) {
			if (!value) return '--';
			const date = new Date(value);
			if (Number.isNaN(date.getTime())) return '--';
			return date.toLocaleString([], { month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', second: '2-digit' });
		}

		function renderProfileQuality(health, progress) {
			const sampleCount = Number(health.sampleCount || 0);
			const accessLine = Number(health.successCount || 0) > 0
				? `访问 平均 ${formatHealthLatency(health.avgDialLatencyMs)} / P95≈${formatHealthLatency(health.p95DialLatencyMs)}`
				: (sampleCount > 0 ? '访问 暂无成功延迟样本' : '访问 暂无样本');
			const successLine = sampleCount > 0
				? `成功率 ${Number(health.successRate || 0).toFixed(1)}%（${health.successCount || 0} 成功 / ${health.failureCount || 0} 失败） · 连败 ${health.consecutiveFailures || 0}`
				: '成功率 --';
			const manual = health.lastManualTest || {};
			const hasEgressLatency = Object.prototype.hasOwnProperty.call(manual, 'egressProbeLatencyMs');
			const manualLine = manual.completedAt
				? `手测 SSH ${formatHealthLatency(manual.sshHandshakeLatencyMs)} / 出口 ${hasEgressLatency ? formatHealthLatency(manual.egressProbeLatencyMs) : '--'}`
				: '手测 尚未执行';
			const access = health.lastAccess || {};
			let latestAt = access.at || '';
			let latestTarget = access.target || '';
			let latestError = access.error || '';
			if (manual.completedAt && (!latestAt || new Date(manual.completedAt) > new Date(latestAt))) {
				latestAt = manual.completedAt;
				latestTarget = manual.probeTarget || '手动出口探测';
				latestError = manual.error || '';
			}
			if (progress && progress.status === 'failed') latestError = progress.error || latestError;
			const errorLine = latestError
				? `<div class="small text-danger text-truncate" style="max-width:360px" title="${escapeHtml(latestError)}"><i class="bi bi-exclamation-circle me-1"></i>${escapeHtml(latestError)}</div>`
				: '';
			return `<div class="small fw-medium">${accessLine}</div>
				<div class="small text-muted">${successLine}</div>
				<div class="small text-muted">${manualLine}</div>
				<div class="small text-muted text-truncate" style="max-width:360px" title="${escapeHtml(latestTarget)}">最近 ${formatHealthTime(latestAt)}${latestTarget ? ` · ${escapeHtml(latestTarget)}` : ''}</div>
				${errorLine}`;
		}

        function escapeHtml(text) {
            if (text === null || text === undefined) return '';
            return String(text)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        function escapeAttr(text) {
            return escapeHtml(text);
        }

        function openProfileModal(title) {
            const modalTitle = document.getElementById('profileModalLabel');
            if (modalTitle && title) {
                modalTitle.innerHTML = `<i class="bi bi-diagram-3"></i> ${title}`;
            }
            const modal = new bootstrap.Modal(document.getElementById('profileModal'));
            modal.show();
        }

        function applyProfileFormValues(profile, options = {}) {
            const formProfile = profile || {};
            const resetId = !!options.resetId;

            document.getElementById('profileId').value = resetId ? '' : (formProfile.profileId || '');
            document.getElementById('profileServerIp').value = formProfile.serverIp || '';
            document.getElementById('profileServerSshPort').value = formProfile.serverSshPort || 22;
            document.getElementById('profileLoginUser').value = formProfile.loginUser || '';
            document.getElementById('profilePrivateKeyPath').value = formProfile.sshPrivateKeyPath || '';
            document.getElementById('profileLocalAddress').value = formProfile.localAddress || '';
            document.getElementById('profileHttpLocalAddress').value = formProfile.httpLocalAddress || '';
            document.getElementById('profileRetryIntervalSec').value = formProfile.retryIntervalSec || 5;
            document.getElementById('profileHttpBasicUserName').value = formProfile.httpBasicUserName || '';
            document.getElementById('profileHttpBasicPassword').value = formProfile.httpBasicPassword || '';
            document.getElementById('profileHttpDomainFilterFilePath').value = formProfile.httpDomainFilterFilePath || '';
            document.getElementById('profileEnableSocks5').checked = !!formProfile.enableSocks5;
            document.getElementById('profileEnableHttp').checked = !!formProfile.enableHttp;
            document.getElementById('profileEnableHttpOverSSH').checked = !!formProfile.enableHttpOverSSH;
            document.getElementById('profileHttpBasicAuthEnable').checked = !!formProfile.httpBasicAuthEnable;
            document.getElementById('profileEnableHttpDomainFilter').checked = !!formProfile.enableHttpDomainFilter;
            document.getElementById('profileSSHPoolSize').value = formProfile.sshPoolSize || 2;
        }

        function openCreateProfileModal() {
            profileModalMode = 'create';
            profileModalOriginalId = '';
            applyProfileFormValues(currentConfigProfileDefaults, { resetId: true });
            openProfileModal('新增 Profile');
        }

        function fillProfileForm(profileId) {
            const profile = (profilesStore.profiles || {})[profileId];
            if (!profile) return;
            profileModalMode = 'edit';
            profileModalOriginalId = profileId;
            applyProfileFormValues({ profileId, ...profile });
            openProfileModal(`编辑 Profile: ${profileId}`);
        }

        function copyProfile(profileId) {
            const profile = (profilesStore.profiles || {})[profileId];
            if (!profile) return;
            profileModalMode = 'copy';
            profileModalOriginalId = profileId;

            applyProfileFormValues(profile, { resetId: true });

            openProfileModal(`复制 Profile: ${profileId}`);
        }

        async function switchProfile(profileId) {
            if (!profileId) return;
            if (!confirm(`确定切换到 profile: ${profileId} ?\n\n切换后将触发SSH重连。`)) {
                return;
            }
            try {
                const response = await fetch('/admin/profiles/switch', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ targetProfileId: profileId })
                });
                const result = await response.json();
                if (!result.success) {
                    showToast('error', result.message || '切换 profile 失败');
                    return;
                }
                const switchId = result.switchId || '';
                renderSwitchStatus({
                    switchId: switchId,
                    fromProfileId: profilesStore.activeProfileId,
                    toProfileId: profileId,
                    status: result.status || 'SWITCHING',
                    message: result.message || '已触发切换，等待SSH重连'
                });
                showToast('info', result.message || '切换已触发，等待重连完成');
                await pollSwitchStatus(switchId);
            } catch (error) {
                console.error('切换profile失败:', error);
                showToast('error', '切换 profile 失败：' + error.message);
            }
        }

		async function startProfileTests(profileIds) {
			if (!Array.isArray(profileIds) || profileIds.length === 0) return;
			const sortSnapshot = {};
			profileIds.forEach(profileId => {
				sortSnapshot[profileId] = profileHealthStore[profileId] || { status: 'unknown', sampleCount: 0 };
			});
			try {
				const response = await fetch('/admin/profiles/test', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ profileIds })
				});
				const result = await response.json();
				if (!response.ok || !result.success) {
					showToast('error', result.message || '启动 Profile 测试失败');
					return;
				}
				currentProfileTestId = result.testId || '';
				profileTestSortSnapshot = sortSnapshot;
				profileTestProgress = (result.data && result.data.results) || {};
				renderProfilesTable();
				showToast('info', `已开始测试 ${profileIds.length} 个 Profile`);
				await pollProfileTest(currentProfileTestId);
			} catch (error) {
				console.error('启动Profile测试失败:', error);
				showToast('error', '启动 Profile 测试失败：' + error.message);
			}
		}

		async function pollProfileTest(testId) {
			if (!testId) return;
			let attempts = 0;
			while (currentProfileTestId === testId && attempts < 180) {
				try {
					const response = await fetch(`/admin/profiles/test/status?testId=${encodeURIComponent(testId)}`);
					const result = await response.json();
					if (!response.ok || !result.success) {
						throw new Error(result.message || '读取测试状态失败');
					}
					const batch = result.data || {};
					profileTestProgress = batch.results || {};
					await loadProfileHealth(false);
					if (batch.status === 'COMPLETED') {
						currentProfileTestId = '';
						profileTestSortSnapshot = {};
						renderProfilesTable();
						const failures = Object.values(profileTestProgress).filter(item => item && item.status === 'failed').length;
						showToast(failures ? 'info' : 'success', failures ? `测试完成，${failures} 个 Profile 不通` : '全部 Profile 测试通过');
						return;
					}
					renderProfilesTable();
				} catch (error) {
					console.error('读取Profile测试状态失败:', error);
				}
				attempts++;
				await new Promise(resolve => setTimeout(resolve, 1000));
			}
			if (currentProfileTestId === testId) {
				currentProfileTestId = '';
				profileTestSortSnapshot = {};
				showToast('error', 'Profile 测试状态等待超时');
				renderProfilesTable();
			}
		}

		function testProfile(profileId) {
			startProfileTests([profileId]);
		}

		function testAllProfiles() {
			const profileIds = Object.keys(profilesStore.profiles || {});
			startProfileTests(profileIds);
		}

        async function deleteProfile(profileId) {
            if (!profileId) return;
            if (profileId === (profilesStore.activeProfileId || '')) {
                showToast('error', '不能删除当前激活的 Profile');
                return;
            }
            if (!confirm(`确定删除 profile: ${profileId} ?\n\n此操作不可撤销。`)) {
                return;
            }
            try {
                const response = await fetch('/admin/profiles/delete', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ profileId: profileId })
                });
                const result = await response.json();
                if (!result.success) {
                    showToast('error', result.message || '删除 profile 失败');
                    return;
                }
                showToast('success', result.message || '删除 profile 成功');
                await loadProfiles();
            } catch (error) {
                console.error('删除profile失败:', error);
                showToast('error', '删除 profile 失败：' + error.message);
            }
        }

        function collectProfilePayload() {
            return {
                profileId: document.getElementById('profileId').value.trim(),
                profile: {
                    serverIp: document.getElementById('profileServerIp').value.trim(),
                    serverSshPort: parseInt(document.getElementById('profileServerSshPort').value, 10) || 22,
                    loginUser: document.getElementById('profileLoginUser').value.trim(),
                    sshPrivateKeyPath: document.getElementById('profilePrivateKeyPath').value.trim(),
                    localAddress: document.getElementById('profileLocalAddress').value.trim(),
                    httpLocalAddress: document.getElementById('profileHttpLocalAddress').value.trim(),
                    enableHttp: document.getElementById('profileEnableHttp').checked,
                    enableSocks5: document.getElementById('profileEnableSocks5').checked,
                    enableHttpOverSSH: document.getElementById('profileEnableHttpOverSSH').checked,
                    httpBasicAuthEnable: document.getElementById('profileHttpBasicAuthEnable').checked,
                    httpBasicUserName: document.getElementById('profileHttpBasicUserName').value.trim(),
                    httpBasicPassword: document.getElementById('profileHttpBasicPassword').value.trim(),
                    enableHttpDomainFilter: document.getElementById('profileEnableHttpDomainFilter').checked,
                    httpDomainFilterFilePath: document.getElementById('profileHttpDomainFilterFilePath').value.trim(),
                    retryIntervalSec: parseInt(document.getElementById('profileRetryIntervalSec').value, 10) || 5,
                    sshPoolSize: parseInt(document.getElementById('profileSSHPoolSize').value, 10) || 2
                }
            };
        }

        async function saveProfile(event) {
            event.preventDefault();
            const btn = document.getElementById('saveProfileBtn');
            const originalText = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>保存中...';

            try {
                const payload = collectProfilePayload();
                if (!payload.profileId) {
                    showToast('error', 'Profile ID 不能为空');
                    return;
                }

                const existingProfiles = profilesStore.profiles || {};
                const exists = Object.prototype.hasOwnProperty.call(existingProfiles, payload.profileId);
                if (profileModalMode === 'create' || profileModalMode === 'copy') {
                    if (exists) {
                        showToast('error', `Profile ID 已存在: ${payload.profileId}，请使用新的 ID`);
                        return;
                    }
                }
                if (profileModalMode === 'edit') {
                    if (exists && payload.profileId !== profileModalOriginalId) {
                        showToast('error', `Profile ID 已存在: ${payload.profileId}，请使用新的 ID`);
                        return;
                    }
                }

                const response = await fetch('/admin/profiles/upsert', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(payload)
                });
                const result = await response.json();
                if (!result.success) {
                    showToast('error', result.message || '保存 profile 失败');
                    return;
                }
                showToast('success', 'Profile 保存成功');
                const modal = bootstrap.Modal.getInstance(document.getElementById('profileModal'));
                if (modal) {
                    modal.hide();
                }
                await loadProfiles();
            } catch (error) {
                console.error('保存profile失败:', error);
                showToast('error', '保存 profile 失败：' + error.message);
            } finally {
                btn.disabled = false;
                btn.innerHTML = originalText;
            }
        }

        function clearProfileForm() {
            document.getElementById('profileForm').reset();
            document.getElementById('profileId').value = '';
            applyProfileFormValues({}, { resetId: true });
            profileModalMode = 'create';
            profileModalOriginalId = '';
        }

        document.getElementById('profileForm').addEventListener('submit', saveProfile);
        document.getElementById('clearProfileFormBtn').addEventListener('click', clearProfileForm);
        document.getElementById('openCreateProfileBtn').addEventListener('click', openCreateProfileModal);
        document.getElementById('reloadProfilesBtn').addEventListener('click', loadProfiles);
		document.getElementById('testAllProfilesBtn').addEventListener('click', testAllProfiles);

        // 搜索功能
        document.getElementById('configSearch').addEventListener('keyup', function() {
            filterConfigs();
        });

        // 分类过滤功能
        document.getElementById('categoryFilter').addEventListener('change', function() {
            filterConfigs();
        });

        function filterConfigs() {
            const searchText = document.getElementById('configSearch').value.toLowerCase();
            const selectedCategory = document.getElementById('categoryFilter').value;
            const items = document.querySelectorAll('.config-item');

            items.forEach(item => {
                const itemText = item.textContent.toLowerCase();
                const itemCategory = item.getAttribute('data-category');
                
                // 移除高亮
                removeHighlight(item);
                
                let showItem = true;
                
                // 检查搜索条件
                if (searchText && !itemText.includes(searchText)) {
                    showItem = false;
                }
                
                // 检查分类条件
                if (selectedCategory && itemCategory !== selectedCategory) {
                    showItem = false;
                }
                
                if (showItem) {
                    item.style.display = '';
                    // 如果有搜索文本，高亮匹配内容
                    if (searchText) {
                        highlightText(item.querySelector('td:first-child'), searchText);
                        highlightText(item.querySelector('td:nth-child(2)'), searchText);
                    }
                } else {
                    item.style.display = 'none';
                }
            });
        }

        // 高亮文本函数
        function highlightText(element, searchText) {
            if (!element || !searchText) return;

            const walker = document.createTreeWalker(
                element,
                NodeFilter.SHOW_TEXT,
                null,
                false
            );

            const textNodes = [];
            let node;
            while (node = walker.nextNode()) {
                textNodes.push(node);
            }

            textNodes.forEach(textNode => {
                const text = textNode.textContent;
                const lowerText = text.toLowerCase();
                const index = lowerText.indexOf(searchText);
                
                if (index !== -1) {
                    const before = text.substring(0, index);
                    const match = text.substring(index, index + searchText.length);
                    const after = text.substring(index + searchText.length);
                    
                    const span = document.createElement('span');
                    span.innerHTML = before + '<span class="highlight">' + match + '</span>' + after;
                    
                    textNode.parentNode.replaceChild(span, textNode);
                }
            });
        }

        // 移除高亮
        function removeHighlight(element) {
            if (!element) return;
            
            const highlighted = element.querySelectorAll('.highlight');
            highlighted.forEach(span => {
                const parent = span.parentNode;
                parent.replaceChild(document.createTextNode(span.textContent), span);
                parent.normalize();
            });
        }

        // 复制全部配置功能
        document.getElementById('copyAllBtn').addEventListener('click', function() {
            const table = document.querySelector('table');
            let content = '';
            
            if (table) {
                const rows = table.querySelectorAll('tbody tr');
                rows.forEach(row => {
                    if (row.style.display !== 'none') {
                        const cells = row.querySelectorAll('td');
                        const key = cells[0].textContent.split('\n')[0].trim();
                        const value = cells[1].textContent.trim();
                        content += `${key}: ${value}\n`;
                    }
                });
            } else {
                content = document.getElementById('config-content').textContent;
            }

            navigator.clipboard.writeText(content)
                .then(() => {
                    const btn = this;
                    const originalText = btn.innerHTML;
                    btn.innerHTML = '<i class="bi bi-check"></i> 已复制';
                    btn.classList.remove('btn-outline-primary');
                    btn.classList.add('btn-success');
                    setTimeout(() => {
                        btn.innerHTML = originalText;
                        btn.classList.remove('btn-success');
                        btn.classList.add('btn-outline-primary');
                    }, 2000);
                })
                .catch(err => console.error('复制失败:', err));
        });        // 复制配置文件路径功能
        document.getElementById('copyPathBtn').addEventListener('click', function() {
            const pathInput = this.parentElement.querySelector('input');
            const path = pathInput.value;

            navigator.clipboard.writeText(path)
                .then(() => {
                    const originalContent = this.innerHTML;
                    this.innerHTML = '<i class="bi bi-check"></i>';
                    setTimeout(() => this.innerHTML = originalContent, 2000);
                })
                .catch(err => console.error('复制路径失败:', err));
        });

        // 复制程序执行路径功能
        document.getElementById('copyExecPathBtn').addEventListener('click', function() {
            const pathInput = this.parentElement.querySelector('input');
            const path = pathInput.value;

            navigator.clipboard.writeText(path)
                .then(() => {
                    const originalContent = this.innerHTML;
                    this.innerHTML = '<i class="bi bi-check"></i>';
                    setTimeout(() => this.innerHTML = originalContent, 2000);
                })
                .catch(err => console.error('复制程序路径失败:', err));
        });

        // 复制工作目录功能
        document.getElementById('copyWorkDirBtn').addEventListener('click', function() {
            const pathInput = this.parentElement.querySelector('input');
            const path = pathInput.value;

            navigator.clipboard.writeText(path)
                .then(() => {
                    const originalContent = this.innerHTML;
